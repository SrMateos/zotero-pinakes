pref-title = Pinakes
pref-s2-key = Semantic Scholar API key (optional)
pref-s2-key-help = Without a key, Semantic Scholar allows a small shared request rate. Request a free key at semanticscholar.org/product/api. The key is sent only to api.semanticscholar.org.
pref-source-title = Reference source
pref-source = Try first:
pref-source-s2 =
    .label = Semantic Scholar
pref-source-openalex =
    .label = OpenAlex
pref-source-help = If the first source fails or has no references, the other one is tried. Lists already cached are not re-fetched until you press Refresh.
pref-pdf-fallback =
    .label = When no API has references, read the bibliography from the PDF
pref-pdf-fallback-help = Entries are resolved through Crossref (api.crossref.org), one request per entry. This runs automatically in the PDF reader; in the library view a button starts it.
pref-target-title = Where imported references go
pref-target-selected =
    .label = The collection selected in the main window (library root if none is selected)
pref-target-parent =
    .label = The collection that contains the paper being read (library root if none)
pref-target-root =
    .label = Always the root of the paper's library
pref-about = { $name } { $version }, built { $time }

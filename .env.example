# Copy to `.env` (git-ignored) and adjust. Used by `npm start` and
# `npm run test:zotero`.

# Zotero binary. Linux tarball default; macOS:
# /Applications/Zotero.app/Contents/MacOS/zotero
ZOTERO_PLUGIN_ZOTERO_BIN_PATH = /opt/zotero/zotero

# Profile used for development. If unset, a fresh one is created in
# .scaffold/profile. Create one with `/opt/zotero/zotero -P`.
# ZOTERO_PLUGIN_PROFILE_PATH = /path/to/dev/profile

# Data directory (zotero.sqlite + storage). Keep it separate from your real
# library unless you mean to test against it; your everyday Zotero must be
# closed if you point this at ~/Zotero.
ZOTERO_PLUGIN_DATA_DIR = ./.scaffold/dev-data

{
  "name": "zotero-pinakes",
  "type": "module",
  "version": "0.1.0",
  "description": "Shows the reference list of the paper you are reading and imports cited works into Zotero.",
  "config": {
    "addonName": "Pinakes",
    "addonID": "pinakes@srmateos.github.io",
    "addonRef": "pinakes",
    "addonInstance": "Pinakes",
    "prefsPrefix": "extensions.zotero.pinakes"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srmateos/zotero-pinakes.git"
  },
  "author": "srmateos",
  "bugs": {
    "url": "https://github.com/srmateos/zotero-pinakes/issues"
  },
  "homepage": "https://github.com/srmateos/zotero-pinakes#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "tsc -p test/unit && node -e \"require('fs').writeFileSync('.scaffold/unit/package.json', '{\\\"type\\\":\\\"commonjs\\\"}')\" && node --test .scaffold/unit/test/unit/*.test.js",
    "test:zotero": "sh test/zotero/run.sh"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.3.0",
    "eslint": "^9.39.2",
    "mocha": "^11.8.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
